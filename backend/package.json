{
  "name": "inventory-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant e-commerce API (Express + MongoDB)",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:indexes": "node scripts/migrateTenantIndexes.js",
    "migrate:attributes": "node scripts/migrateAttributesPerStore.js",
    "backfill:is-deleted": "node scripts/backfillIsDeleted.js",
    "backfill:address-store": "node scripts/backfillAddressStoreId.js",
    "backfillSubdomains": "node scripts/backfillSubdomains.js --apply",
    "backfill:translations": "node scripts/backfillTranslations.js",
    "translation:check": "node scripts/backfillTranslations.js --check",
    "argos:serve": "uv run --python 3.13 --with ctranslate2 --with sentencepiece python scripts/argosTranslateServer.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fs-extra": "^11.4.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
