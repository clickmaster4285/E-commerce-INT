# Copy these Argos/translation keys into backend/.env on each deployment.
# backend/.env is intentionally gitignored; this file contains no secrets.
ARGOS_HOST=127.0.0.1
ARGOS_PORT=5055
LIBRETRANSLATE_URL=http://127.0.0.1:5055
LIBRETRANSLATE_API_KEY=
TRANSLATE_SOURCE_LANG=en
TRANSLATE_SOURCE_LANGUAGE_NAME=English
TRANSLATE_TARGET_LOCALES=ur,ar,es,fr,de,hi,zh,pt,tr
TRANSLATE_BATCH_SIZE=10
TRANSLATE_TIMEOUT_MS=30000
TRANSLATE_MAX_RETRIES=3
TRANSLATE_RETRY_BASE_DELAY_MS=1000
TRANSLATE_READY_TIMEOUT_MS=900000
TRANSLATE_REUSE_GRACE_MS=75000
TRANSLATE_HEALTHCHECK_TIMEOUT_MS=3000
TRANSLATE_READY_POLL_INTERVAL_MS=2500
TRANSLATE_REUSE_POLL_INTERVAL_MS=2000
TRANSLATION_MAX_BODY_BYTES=4194304
TRANSLATION_MODEL_DIR=~/.cache/ecommerce-translation/m2m100-ct2-int8
TRANSLATION_MODEL_BASE_URL=https://huggingface.co
TRANSLATION_MODEL_REPOSITORY=JustFrederik/m2m_100_418m_ct2_int8
TRANSLATION_MODEL_REVISION=1aeed44db4dd61a486bba44acf54c76507082a2c
TRANSLATION_MODEL_FILES=model.bin,490667638,6c8ef4e814a02d5947ab80710f93f3d4e776bf4b668ab3bb7996ff050b69d111;shared_vocabulary.txt,1159930,bd440aa21b8ca3453fc792a0018a1f3fe68b3464aadddd4d16a4b72f73c86d8c;spm.128k.model,2423393,d8f7c76ed2a5e0822be39f0a4f95a55eb19c78f4593ce609e2edbc2aea4d380a;config.json,158,531f7f8d8bf8b73a1580b73c04b58bf134ac490284f4f7af6c20ad238499ae37
TRANSLATION_TOKENIZER_MODEL_FILE=spm.128k.model
TRANSLATION_MODEL_DOWNLOAD_TIMEOUT_SECONDS=60
TRANSLATION_MODEL_DOWNLOAD_RETRIES=3
TRANSLATION_MODEL_DOWNLOAD_CHUNK_BYTES=1048576
TRANSLATION_ENGINE=ct2
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=int8
TRANSLATION_INTER_THREADS=1
TRANSLATION_INTRA_THREADS=4
