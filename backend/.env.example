# ==========================================
# 🔐 SERVER CONFIG (sab values sirf yahan se — code me koi || fallback nahi)
# ==========================================
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=
ALLOW_LOCAL_NETWORK=false
TRUST_PROXY=
JWT_SECRET=change_me_to_a_long_random_secret
MONGO_URI=mongodb://localhost:27017/ecommerce
NEXT_PUBLIC_SERVERURL=http://localhost:5000/api
GOOGLE_CLIENT_ID=
SERVER_STARTUP_MESSAGE=Backend server is running
REQUEST_SIZE_LIMIT=20mb
BCRYPT_SALT_ROUNDS=10
UPLOAD_DIR=uploads
STORE_UPLOAD_SUBDIR=store
UPLOAD_CACHE_MAX_AGE=7d
MAX_UPLOAD_SIZE_MB=8
SOCKET_MAX_BUFFER_MB=15

# ==========================================
# 👤 DEFAULT ADMIN
# ==========================================
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_ROLE=admin

# ==========================================
# 🏪 DEFAULT STORE SETTINGS
# ==========================================
DEFAULT_STORE_NAME=My Professional Store
DEFAULT_STORE_TAGLINE=Welcome to our store
DEFAULT_STORE_EMAIL=store@example.com
DEFAULT_STORE_PHONE=+923001234567
DEFAULT_STORE_SUPPORT_EMAIL=support@example.com
DEFAULT_STORE_SUPPORT_PHONE=+923001234567
DEFAULT_STORE_COUNTRY=PK
DEFAULT_STORE_STATE=
DEFAULT_STORE_CITY=
DEFAULT_STORE_ZIP_CODE=
DEFAULT_STORE_ADDRESS=
DEFAULT_STORE_CURRENCY=PKR
DEFAULT_STORE_TAX_RATE=0
DEFAULT_STORE_WEIGHT_UNIT=kg
DEFAULT_STORE_STATUS=open

# jwt expiree
JWT_ACCESS_TOKEN_EXPIREE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIREE_DAYS=30

# ==========================================
# 📧 EMAIL / SMTP (OTP emails)
# ==========================================
# Gmail: host smtp.gmail.com, port 587, secure false,
# user = gmail, pass = 16-char Google App Password (normal password nahi chalega)
# SMTP khaali ho to dev fallback: OTP backend console par print hoga
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ==========================================
# 🔐 OTP CONFIG
# ==========================================
EMAIL_OTP_EXPIRE_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
OTP_LENGTH=6
RESET_TOKEN_EXPIRE_MINUTES=10

# ==========================================
# 🚦 RATE LIMIT (window sab routes par same)
# ==========================================
# Window minutes. Limits = us window me max requests.
# USER multiplier logged-in customers ke liye (global par), ADMIN 0 = unlimited.
# WHITELIST_IPS comma-separated (inko limit nahi lagegi). TRUST_PROXY blank = off.
# REDIS_URL set ho to redis store, warna memory store.
RATE_LIMIT_WINDOW_MINUTES=5
# NOTE: har page load ~10-15 API calls karta hai, is liye 300 (100 me normal browsing rukti hai)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_SEND_EMAIL_OTP_MAX=3
RATE_LIMIT_VERIFY_EMAIL_OTP_MAX=10
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_VERIFY_RESET_OTP_MAX=10
RATE_LIMIT_RESET_PASSWORD_MAX=5
RATE_LIMIT_GOOGLE_LOGIN_MAX=10
RATE_LIMIT_ADMIN_LOGIN_MAX=5
RATE_LIMIT_ORDER_CREATE_MAX=10
RATE_LIMIT_REVIEW_CREATE_MAX=5
RATE_LIMIT_USER_MULTIPLIER=2
RATE_LIMIT_ADMIN_MULTIPLIER=0
RATE_LIMIT_WHITELIST_IPS=
REDIS_URL=
