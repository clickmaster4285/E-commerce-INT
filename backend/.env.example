# Copy to backend/.env and fill in real values.
# Server refuses to boot unless MongoDB is a replica set (optimizeplan.md §3.1).

# Prefer 127.0.0.1 (not localhost) — rs member is registered as 127.0.0.1:27017.
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0&retryWrites=true&w=majority

# Optional pool / timeouts (defaults shown)
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=0
# MONGO_SERVER_SELECTION_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_AUTO_INDEX=false

# Staging only: enable profiler (slowms). Leave unset in production unless ops owns it.
# MONGO_PROFILE_SLOWMS=100

PORT=5000
API_PREFIX=/api
ROOT_DOMAIN=localhost
NODE_ENV=development
LOG_LEVEL=warn

# JWT secrets — use six distinct random values in production
JWT_SECRET=change-me-purpose-tokens
JWT_USER_ACCESS_SECRET=change-me-user-access
JWT_USER_REFRESH_SECRET=change-me-user-refresh
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access
JWT_ADMIN_REFRESH_SECRET=change-me-admin-refresh
JWT_SA_ACCESS_SECRET=change-me-sa-access
JWT_SA_REFRESH_SECRET=change-me-sa-refresh

INTERNAL_PROXY_SECRET=change-me-proxy
UPLOAD_DIR=uploads
PUBLIC_STORE_PROTOCOL=http

# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# REDIS_URL=
# LIBRETRANSLATE_URL=
