# ==========================================================
# backend/.env.example — placeholders only (REAL secrets yahan kabhi nahi)
# Copy: cp .env.example .env  (phir values badlo)
# [REQUIRED] = hamesha chahiye (config/env.js startup par check karta hai)
# [PROD]     = production me required, dev me optional
# [OPTIONAL] = blank chhod sakte ho
# ==========================================================

# --- Core ---
NODE_ENV=development                 # [OPTIONAL] development | production | test
PORT=5000                            # [REQUIRED] 1-65535
HOST=0.0.0.0                         # [OPTIONAL]
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0&retryWrites=true&w=majority   # [REQUIRED] replica set zaroori (transactions)
SERVER_STARTUP_MESSAGE=API running   # [OPTIONAL]
BCRYPT_SALT_ROUNDS=10                # [OPTIONAL]
TRUST_PROXY=                         # [OPTIONAL]

# --- Multi-tenant ---
ROOT_DOMAIN=localhost                # [PROD] platform host
CLIENT_URL=http://localhost:3000     # [PROD]
ALLOWED_ORIGINS=                     # [OPTIONAL] comma separated
INTERNAL_PROXY_SECRET=change-me      # [PROD] frontend .env me same value
PUBLIC_STORE_PROTOCOL=http           # [PROD] https
PUBLIC_STORE_PORT=                   # [OPTIONAL]

# --- JWT (production me 6 ALAG random values) ---
JWT_SECRET=change-me                 # [PROD] sirf short-lived purpose tokens
JWT_USER_ACCESS_SECRET=change-me     # [PROD]
JWT_USER_REFRESH_SECRET=change-me    # [PROD]
JWT_ADMIN_ACCESS_SECRET=change-me    # [PROD]
JWT_ADMIN_REFRESH_SECRET=change-me   # [PROD]
JWT_SA_ACCESS_SECRET=change-me       # [PROD]
JWT_SA_REFRESH_SECRET=change-me      # [PROD]

# --- Redis (shared rate limit + handoff single-use) ---
REDIS_URL=                           # [OPTIONAL] redis://host:6379 — blank ho to MongoDB fallback

# --- Super admin seed ---
SUPER_ADMIN_EMAIL=admin@example.com  # [OPTIONAL]
SUPER_ADMIN_PASSWORD=change-me       # [OPTIONAL]
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_MIN_PASSWORD_LENGTH=12

# --- Uploads ---
UPLOAD_DIR=uploads
STORE_UPLOAD_SUBDIR=stores
BUNDLE_UPLOAD_SUBDIR=bundles
REVIEW_UPLOAD_SUBDIR=reviews
UPLOAD_CACHE_MAX_AGE=
REQUEST_SIZE_LIMIT=6mb

# --- SMTP (blank ho to dev console fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Google login ---
GOOGLE_CLIENT_ID=                    # frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID jaisi value

# --- Translation (LibreTranslate / Argos) ---
LIBRETRANSLATE_URL=http://127.0.0.1:5001
LIBRETRANSLATE_API_KEY=
TRANSLATE_TARGET_LOCALES=ur,ar
TRANSLATE_SOURCE_LANG=en
# NOTE: asli backend/.env me TRANSLATION_MODEL_DOWNLOAD_CHUNK_BYTES do baar ho sakta hai —
# sirf EK entry rakho (baad wali jeet jati hai). .env ko yahan se edit nahi kiya gaya.
TRANSLATION_MODEL_DOWNLOAD_CHUNK_BYTES=1048576

# --- Rate limits (optional overrides) ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=
